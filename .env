# --- File system -----------------------------------------------------------
PROFILER_DATA_DIR=/data/mounted
PROFILER_UPLOAD_DIR=/data/uploads
PROFILER_OUTPUT_DIR=/data/output

# --- Upload limits --------------------------------------------------------
MAX_UPLOAD_SIZE_MB=500
UPLOAD_TTL_HOURS=1

# --- Server ---------------------------------------------------------------
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8080

# --- Parallelism ----------------------------------------------------------
MAX_PARALLEL_WORKERS=4

# --- DuckDB (STREAM_ONLY engine for >2 GB CSVs) --------------------------
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREADS=4

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
